# Скопируйте этот файл в .env и заполните своими значениями.
# Как пользоваться админ-панелью — см. README.md

# Пароль для входа в /admin (не короче 12 символов).
# Без ADMIN_PASSWORD админ-панель будет недоступна (вернёт ошибку 503).
# После пароля в Telegram (на все CHAT_ID) приходит код подтверждения —
# поэтому в CHAT_ID должны быть только те, кому можно входить в админку.
ADMIN_PASSWORD=придумайте_надёжный_пароль

# Запасной вариант, если Telegram недоступен: ADMIN_2FA=off — вход только по
# паролю. Обычно НЕ задавайте.
# ADMIN_2FA=off

# Телеграм-бот для уведомлений о новых записях (см. README.md, раздел Telegram).
# Без них запись всё равно сохранится, просто без уведомления.
BOT_TOKEN=вставьте_сюда_токен_бота_от_BotFather
CHAT_ID=вставьте_сюда_ваш_chat_id

# База данных PostgreSQL для постоянного хранения записей (например, бесплатный Neon:
# neon.tech → проект → Connect → строка подключения). Без неё записи хранятся
# в файлах data/*.json — на бесплатном Render они стираются при каждом обновлении.
DATABASE_URL=

# Порт, на котором запустится сервер (необязательно)
PORT=3000

# Включите (1), только если сайт работает ЗА реверс-прокси (nginx, Cloudflare
# и т.п.), который сам принимает соединения от посетителей и перенаправляет
# их на этот сервер. Это нужно, чтобы защита от перебора пароля и от спама
# в записи видела настоящий IP посетителя, а не IP самого прокси.
# Если сайт слушает порт напрямую из интернета (прокси нет) — НЕ включайте,
# иначе IP можно будет подделать через заголовок и обойти блокировки.
# На Render (Cloudflare → балансировщик → внутренний прокси) ставьте 3.
# Проверка: войдите в админку и откройте /api/admin/whoami — там должен быть ваш IP.
TRUST_PROXY=0

# Утренняя сводка записей в Telegram (её вызывает сервис cron-job.org по адресу
# /api/cron/daily-summary?key=ЭТОТ_СЕКРЕТ). Длинная случайная строка, не короче
# 20 символов. Пусто — сводка выключена.
CRON_SECRET=

# Адрес сайта для ссылок отмены в календаре (необязательно — по умолчанию
# определяется сам). Пример: https://massage-booking-1.onrender.com
PUBLIC_URL=
